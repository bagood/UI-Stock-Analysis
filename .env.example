# Agentic stock-analysis API through Nginx. Do not include a trailing slash.
AGENTIC_BASE_URL=https://backend-production.stocknub.online/api

# Account and portfolio API through Nginx. Do not include a trailing slash.
ORGANIZER_BASE_URL=https://backend-production.stocknub.online/organizer

# Stateless Assistant API. Do not include a trailing slash.
ASSISTANT_BASE_URL=http://127.0.0.1:8005

# Next.js proxy validation; keep aligned with the Assistant service.
CHAT_MAX_INPUT_CHARS=2000
